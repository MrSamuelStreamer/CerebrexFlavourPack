<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    Consciousness uses setMax 0.1 rather than 0 on purpose. Consciousness is lethalMechanoids, and
    CapableOf() is "level > minForCapable" (0 for this capacity), so setMax 0 would kill the mech
    outright. 0.1 keeps it alive but below the 0.3 CanBeAwake threshold - the swarm goes dark
    instead of instantly evaporating.
  -->
  <HediffDef>
    <defName>CFP_CerebrexShutdown</defName>
    <label>cerebrex shutdown</label>
    <labelNoun>a cerebrex shutdown</labelNoun>
    <description>With the cerebrex core gone there is nothing left to issue orders. This mech is running on nothing but residual charge and will never take another command.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.75, 0.25, 0.25)</defaultLabelColor>
    <isBad>true</isBad>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.1</setMax>
          </li>
          <li>
            <capacity>Moving</capacity>
            <setMax>0</setMax>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <setMax>0</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <!--
    painOffset 0.75 is deliberately just under the 0.8 PainShockThreshold default so the pawn
    stays conscious and mobile after processing instead of collapsing forever. That leaves only
    ~0.05 of headroom before any further injury downs them - that fragility is intended, and this
    value is the knob to turn if it feels too harsh or too lenient.

    Permanence comes from omission, not a comp: no HediffCompProperties_Disappears/_Immunizable/
    _SeverityPerDay, plus tendable false and everCurableByItem false. Deliberately NOT using
    HediffComp_GetsPermanent - that comp exists to turn injuries into scars and rolls a random
    PainCategory that would fight this hediff's fixed painOffset.

    skinColorOverride tints every colorType=Skin render node (see HediffSet.GetSkinColor), which
    covers the head and any body type with no dedicated "Peeled" texture (Child/Baby) for free.
    The body/head texture swap itself is handled in Harmony_PeeledPawn.cs.
  -->
  <HediffDef>
    <defName>CFP_SkinnedAlive</defName>
    <label>skinned alive</label>
    <labelNoun>a skinning</labelNoun>
    <description>The integument extraction process has stripped away the skin, leaving raw flesh exposed. The wound will never fully close, and the pain will never fully fade.</description>
    <hediffClass>CerebrexFlavourPack.Hediff_SkinnedAlive</hediffClass>
    <defaultLabelColor>(0.75, 0.25, 0.25)</defaultLabelColor>
    <isBad>true</isBad>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <tendable>false</tendable>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <chanceToCauseNoPain>0</chanceToCauseNoPain>
    <skinColorOverride>(0.72, 0.28, 0.26)</skinColorOverride>
    <stages>
      <li>
        <painOffset>0.75</painOffset>
      </li>
    </stages>
  </HediffDef>

</Defs>
