<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>CFP_HumanProcessor</defName>
    <label>human processor</label>
    <description>PLACEHOLDER</description>
    
    <thingClass>Building</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <!-- tickerType required as Normal -->
    <tickerType>Normal</tickerType>
    <altitudeLayer>Building</altitudeLayer>
    <size>(3,3)</size>
    <rotatable>false</rotatable>
    <passability>PassThroughOnly</passability>
    <castEdgeShadows>false</castEdgeShadows>
    <blockWind>true</blockWind>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-2)</interactionCellOffset>
    <destroyable>true</destroyable>
    <useHitPoints>true</useHitPoints>
    <designationCategory>Misc</designationCategory>
    <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
    <containedPawnsSelectable>true</containedPawnsSelectable>

    <graphicData>
      <texPath>Building/HumanProcessor</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <researchPrerequisites>
      <li>Machining</li>
    </researchPrerequisites>
    <statBases>
      <MaxHitPoints>400</MaxHitPoints>
      <WorkToBuild>30000</WorkToBuild>
      <Flammability>0</Flammability>
      <Beauty>1</Beauty>
    </statBases>
    <costList>
      <Steel>200</Steel>
      <Plasteel>40</Plasteel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <building>
      <isEdifice>false</isEdifice>
      <deconstructible>true</deconstructible>
      <claimable>true</claimable>
      <isTargetable>true</isTargetable>
      <repairable>true</repairable>
      <ai_neverTrashThis>false</ai_neverTrashThis>
    </building>

    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>6</glowRadius>
        <glowColor>(90,240,240,0)</glowColor> <!-- cyan, similar to friendly mechanoid -->
      </li>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>200</basePowerConsumption>
      </li>
      <!-- pawn is destroyed after processing, leaving behind only blood (filth) and loot
       default bloodFilth multiplier if left blank is 5, override below in tag -->
      <li Class="CerebrexFlavourPack.CompProperties_PrisonerProcessor">
        <ticksToKill>6000</ticksToKill>
        <bloodFilthMultiplier>100</bloodFilthMultiplier>
        <products>
          <Meat_Human>75</Meat_Human>
          <Leather_Human>35</Leather_Human>
          <HemogenPack>10</HemogenPack>
        </products>
      </li>
    </comps>
  </ThingDef>

</Defs>
