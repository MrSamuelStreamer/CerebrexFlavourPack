<?xml version="1.0" encoding="utf-8" ?>
<!--
  Cerebrex Emissary PawnKinds.

  Each kind uses a HL_<Mech> race, a humanlike-race ThingDef that Big &
  Small auto-mints at load time from every mechanoid ThingDef. Those
  humanlike races carry the HL_Mech_<Name>_RaceHediff automatically, so
  the pawn spawns already sapient without needing an
  animalSapienceChance swap-at-generation step (which fails inside vanilla
  PawnGroupMakerUtility for raw mechanoid races).

  defaultFactionType (RimWorld XML tag; internal field is defaultFactionDef)
  is explicit on every kind so non-group spawn paths (quest rewards, dev
  spawn, refugee drop) resolve to the Emissary faction, NOT the hostile
  Mechanoid faction.

  Age range 13~200 dodges the Big & Small animal-adult-age-becomes-child-
  post-swap trap that would otherwise disable work assignments.

  Warqueen intentionally excluded. Its CompMechCarrier visitor path is
  untested and any NRE from that path would bury the log.
-->
<Defs>

  <PawnKindDef Name="MSS_CF_Emissary_Base" Abstract="True">
    <defaultFactionType>MSS_CF_CerebrexEmissary</defaultFactionType>
    <biologicalAgeRange>13~200</biologicalAgeRange>
    <chronologicalAgeRange>13~500</chronologicalAgeRange>
  </PawnKindDef>

  <!-- Delegates =============================================== -->

  <PawnKindDef ParentName="MSS_CF_Emissary_Base">
    <defName>MSS_CF_Emissary_Constructoid</defName>
    <label>Cerebrex constructor emissary</label>
    <race>HL_Mech_Constructoid</race>
    <combatPower>50</combatPower>
  </PawnKindDef>

